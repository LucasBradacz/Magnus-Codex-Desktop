<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Release'">Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <!-- Copia as imagens como arquivos soltos para Assets/ no output -->
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <!-- Copia o CSV das cartas para bin/Data/ a cada build (quando disponível) -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\Data\magnus_codex_cartas.csv"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Data\magnus_codex_cartas.csv')"
          CopyToOutputDirectory="PreserveNewest"
          Link="Data\magnus_codex_cartas.csv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MagnusCodex.Domain\MagnusCodex.Domain.csproj" />
    <ProjectReference Include="..\MagnusCodex.Data\MagnusCodex.Data.csproj" />
  </ItemGroup>
</Project>
